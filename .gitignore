# Build artifacts（blinky/firmware ビルドを submodule 委譲で親 build/ へ出す）
/build/

# Central: project.yml と Swift ソースは追跡する。
# xcodegen が生成する成果物（.xcodeproj・Info.plist）とビルド成果物だけ無視する。
/central/CoreBluetoothCentralGuide/*.xcodeproj/
/central/CoreBluetoothCentralGuide/*.xcworkspace/
/central/CoreBluetoothCentralGuide/CoreBluetoothCentralGuide/Info.plist
/central/CoreBluetoothCentralGuide/build/
/central/CoreBluetoothCentralGuide/DerivedData/

# macOS
.DS_Store
