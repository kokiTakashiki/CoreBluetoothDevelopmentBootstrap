# Build artifacts（blinky ビルドを submodule 委譲で親 build/ へ出す）
/build/

# Central: project.yml と Swift ソースは追跡する。
# xcodegen が生成する成果物（.xcodeproj・Info.plist）とビルド成果物だけ無視する。
/central/BLECentralSample/*.xcodeproj/
/central/BLECentralSample/*.xcworkspace/
/central/BLECentralSample/BLECentralSample/Info.plist
/central/BLECentralSample/build/
/central/BLECentralSample/DerivedData/

# macOS
.DS_Store
